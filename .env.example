# Copy to .env at the repository root and fill in your own keys.
# .env is gitignored; this template must never contain a real value.

# Sarvam AI - one key for both stages: sarvam-105b shortens translations that
# overrun their budget, and Bulbul speaks them.
SARVAM_API_KEY= 
# SARVAM_LLM_MODEL=sarvam-105b
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_SPEAKER=shubh

# Optional alternative shortener (translator "indictrans+groq"): GPT-OSS 120B on Groq.
GROQ_API_KEY=

# Local machine translation (downloaded from Hugging Face on first use).
# INDICTRANS_MODEL=ai4bharat/indictrans2-en-indic-dist-200M
